# Evidence HMAC key — required. The app will not start without it.
#   openssl rand -hex 32
# Do not use unsalted hashes: names have low entropy and are vulnerable to dictionary attacks.
EVIDENCE_HMAC_KEY=""
EVIDENCE_KEY_ID="web-k1"
# Dedicated browser-flow token custody. Never reuse the evidence, vault, issuance-journal or signer key.
# During a bounded rotation, seal uses the current key and open may accept the previous key until
# the exact Unix-millisecond deadline. Remove all three PREVIOUS settings to retire it.
SERVER_TOKEN_KEY=""
SERVER_TOKEN_KEY_ID="token-k1"
SERVER_TOKEN_PREVIOUS_KEY=""
SERVER_TOKEN_PREVIOUS_KEY_ID=""
SERVER_TOKEN_PREVIOUS_ACCEPT_UNTIL=""
# Same v3 full-GET freshness policy as CLI; >0 and <=168 hours. No mtime/legacy-index fallback.
SANCTIONS_MAX_AGE_HOURS=168
SANCTIONS_SCREEN_MAX_AGE_HOURS=168
SANCTIONS_ISSUANCE_MAX_AGE_HOURS=24
SANCTIONS_EXPECTED_SNAPSHOT_ID=
FATF_MAX_AGE_DAYS=120
# Required when KYC_DEMO is not 1. JSON must be a validated proofmark-processing-policy-v1
# customer data-flow manifest with actual approval/legal-review/contract refs. It must cover the
# configured vendors, RRN items, stores, regions/transfers, rights channel and public chains.
PROCESSING_POLICY_JSON=
# Required when KYC_DEMO is not 1. JSON must be a validated proofmark-retention-policy-v1
# customer/jurisdiction/outcome schedule covering vault, journal, outbox, backup, vendor,
# logs, client copies and irreversible on-chain effects. Never invent approval references.
RETENTION_POLICY_JSON=
# Required when KYC_DEMO is not 1. JSON must be a validated proofmark-identity-policy-v1 object
# with status=approved and an opaque customer/compliance approvalRef. Do not invent this value.
# Biometrics additionally require prior necessity/legal-basis/approval refs and an enabled adapter.
IDENTITY_POLICY_JSON=

# Hosted Sumsub verification (evidence candidate only; does not issue a mark).
# Optional fixed fictional lesson for /demo, independent of KYC_DEMO. Does not enable demo issuance.
SANCTIONS_TRAINING_ENABLED=0
# No demo fallback. Configure an approved identity/processing/retention policy first.
# Choose ONE environment's credentials; never reuse API, webhook, evidence or state keys.
SUMSUB_ENVIRONMENT=
SUMSUB_PROCESSING_RECIPIENT=
SUMSUB_EVIDENCE_HMAC_KEY=
SUMSUB_STATE_REDIS_REST_URL=
SUMSUB_STATE_REDIS_REST_TOKEN=
SUMSUB_STATE_KEY=
SUMSUB_STATE_TTL_SECONDS=
SUMSUB_STATE_NAMESPACE=proofmark
# `memory` is accepted only by local development with Sandbox test mode. Never set it on Vercel.
SUMSUB_STATE_MODE=
SUMSUB_LOCAL_TEST=0
SUMSUB_SANDBOX_TEST_MODE=0
SUMSUB_SANDBOX_APP_TOKEN=
SUMSUB_SANDBOX_SECRET_KEY=
SUMSUB_SANDBOX_WEBHOOK_SECRET=
SUMSUB_SANDBOX_LEVEL_NAME=
SUMSUB_PRODUCTION_APP_TOKEN=
SUMSUB_PRODUCTION_SECRET_KEY=
SUMSUB_PRODUCTION_WEBHOOK_SECRET=
SUMSUB_PRODUCTION_LEVEL_NAME=
# Optional bounded engineering limits, not approved legal retention or a risk SLA.
SUMSUB_SDK_TTL_SECONDS=600
SUMSUB_WEBHOOK_MAX_AGE_SECONDS=600

NEXT_PUBLIC_CC3_RPC="https://rpc.cc3-testnet.creditcoin.network"
NEXT_PUBLIC_SEPOLIA_RPC="https://ethereum-sepolia-rpc.publicnode.com"

# CC3 Testnet
NEXT_PUBLIC_ASC="0x93C62D3016123Da0aBdB4AC1857564c30CbE5629"
NEXT_PUBLIC_REGISTRY="0x874e0Fd030a8Fe6c7a06835354531b68A31f5FCc"
NEXT_PUBLIC_NOTE="0xA8Dfe6f5063a8159524DedbBAc75f034C3BF0625"
NEXT_PUBLIC_DEMO_SUBJECT=
# Sepolia
NEXT_PUBLIC_SOURCE="0x93C62D3016123Da0aBdB4AC1857564c30CbE5629"

# Operator-approved user tracking targets. Do not set guessed production timings.
ISSUANCE_SOURCE_EXPECTED_SECONDS=
ISSUANCE_HUB_EXPECTED_SECONDS=
ISSUANCE_TRACKING_TIMEOUT_SECONDS=
ISSUANCE_SUPPORT_URL=

# ── KYC vendors (the /verify flow) ──────────────────────────────────────────
# ID document: CODEF (developer.codef.io). demo = real institutions with a daily allowance,
# api = production, sandbox = fixed sample data (never sets a bit).
CODEF_CLIENT_ID=
CODEF_CLIENT_SECRET=
CODEF_PUBLIC_KEY=                 # Key Management > publicKey, base64 body
CODEF_ENV=demo                    # sandbox | demo | api
# The issuer's own joint certificate, used to log in to Government24 / Traffic Civil Service 24 and check the customer's document.
CODEF_CERT_TYPE=pfx               # pfx (one file) | 1 (der + key)
CODEF_CERT_FILE=                  # base64 of the .pfx (or the signCert.der)
CODEF_KEY_FILE=                   # base64 of signPri.key, only for CODEF_CERT_TYPE=1
CODEF_CERT_PASSWORD=              # plain; RSA-encrypted with CODEF_PUBLIC_KEY on every request
CODEF_LOGIN_USER_NAME=            # Corporate or personal name on the certificate
CODEF_LOGIN_IDENTITY=             # Business or resident registration number of the certificate holder

# Bank account: openbanking (KFTC, testbed available to any registered developer) or codef (CODEF_ENV=api, partnership contract)
BANK_VENDOR=openbanking
# Shared atomic challenge/attempt/idempotency state; required for any external bank rail.
# Use one primary Redis REST endpoint + namespace across all app instances. Never NEXT_PUBLIC_.
BANK_STATE_REDIS_REST_URL=
BANK_STATE_REDIS_REST_TOKEN=
BANK_STATE_NAMESPACE=proofmark
OPENBANKING_CLIENT_ID=
OPENBANKING_CLIENT_SECRET=
OPENBANKING_CLIENT_USE_CODE=      # Institution use code, 10 chars (e.g. M202300440)
OPENBANKING_CNTR_ACCOUNT_TYPE=N   # N account number | C fintech use number
OPENBANKING_CNTR_ACCOUNT_NUM=     # the institution's contracted account the ₩1 leaves from
OPENBANKING_WD_PASS_PHRASE=       # Withdrawal-transfer passphrase registered with KFTC
OPENBANKING_PRINT_NAME=Proofmark  # sender name on the customer's statement
OPENBANKING_ENV=test              # test (testapi.openbanking.or.kr, no money moves) | prod

# Issuer: signs ComplianceSource.issueOnce() on Sepolia. Must be allow-listed with setIssuer().
ISSUER_PRIVATE_KEY=
# Optional stable issuer contract transport. Both values are required together. The private key
# is its current operating key; it must NOT also hold ComplianceSource's direct issuer role.
ROTATING_ISSUER_ADDRESS=
ISSUER_KEY_EPOCH=
# Recoverable issuance requires its own encrypted shared journal, including for the public sandbox.
# Use the same namespace and issuer key across API/processor instances; never share that key with deployment/rescreen jobs.
ISSUANCE_JOURNAL_REDIS_REST_URL=
ISSUANCE_JOURNAL_REDIS_REST_TOKEN=
ISSUANCE_JOURNAL_KEY=
ISSUANCE_JOURNAL_NAMESPACE=proofmark
ISSUANCE_CONFIRMATIONS=6
# Shared atomic UTC-day issuer budget in the journal Redis. No defaults: approve both ceilings.
# Use a secret independent from ISSUANCE_JOURNAL_KEY; unknown transactions stay reserved.
ISSUANCE_GAS_BUDGET_KEY=
ISSUANCE_DAILY_GAS_LIMIT=
ISSUANCE_DAILY_TRANSACTION_LIMIT=

# ── Demo mode ───────────────────────────────────────────────────────────────
# KYC_DEMO=1: an axis without a real vendor above gets the built-in demo vendor (demo:id / demo:bank),
# and non-live results (demo, sandbox, testbed) still set their bits. The mark then carries regime
# KR_FSC_NONFACE_SANDBOX and the evidence names the demo vendor. KYC_DEMO_BITS=0 keeps the bits unset.
# In demo the one-won code is shown on the page in place of the bank app. Never set in production.
KYC_DEMO=1
KYC_DEMO_BITS=1

# CODEF login without a certificate: app-based authentication on the operator's phone (approve each check in the app).
# Works on CODEF_ENV=demo for real Government24 / Traffic Civil Service 24 lookups. Overrides the CODEF_CERT_* login above.
CODEF_LOGIN_TYPE=simple           # simple | cert
CODEF_SIMPLE_LEVEL=1              # 1 KakaoTalk · 3 Samsung Pass · 4 KB Mobile · 5 carrier PASS · 6 Naver · 7 Shinhan · 8 Toss · 9 Hana · 10 NH
CODEF_LOGIN_PHONE=                # approver's phone, digits
CODEF_LOGIN_TELECOM=              # 0 SKT · 1 KT · 2 LG U+, only for PASS
# CODEF_LOGIN_USER_NAME / CODEF_LOGIN_IDENTITY (13-digit resident number) are the approver's, see above
