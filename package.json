{
  "name": "proofmark",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "forge build",
    "test": "forge test -vv",
    "worker": "tsx worker/index.ts",
    "worker:init-state": "tsx script/init-worker-state.ts",
    "worker:test": "tsx --test worker/*.test.ts",
    "typecheck": "tsc --noEmit",
    "test:pipeline": "tsx --test pipeline/*.test.ts pipeline/providers/*.test.ts",
    "test:providers": "tsx --test pipeline/providers/*.test.ts",
    "test:providers-redis": "node scripts/test-bank-redis.mjs test/sumsub-redis.integration.ts",
    "sumsub:setup": "node scripts/configure-sumsub-sandbox.mjs",
    "test:zk": "npm --prefix zk test && forge test --match-contract ZkKycPolicyGateTest -vv",
    "test:ts": "tsx --test worker/*.test.ts pipeline/*.test.ts pipeline/providers/*.test.ts aml/*.test.ts",
    "test:aml": "tsx --test aml/*.test.ts",
    "eval:aml": "tsx aml/eval.ts",
    "eval:aml:holdout": "tsx aml/holdout-eval.ts",
    "eval:aml:t25": "tsx aml/t25-eval.ts",
    "benchmark:aml": "tsx aml/benchmark.ts",
    "sanctions:rollout": "tsx script/sanctions-rollout.ts",
    "test:all": "forge test && tsx --test worker/*.test.ts pipeline/*.test.ts pipeline/providers/*.test.ts aml/*.test.ts test/*.test.ts",
    "test:evidence": "tsx script/test-evidence.ts",
    "test:bank-redis": "node scripts/test-bank-redis.mjs",
    "test:issuance-redis": "node scripts/test-bank-redis.mjs test/issuance-redis.integration.ts",
    "test:issuance-budget": "node scripts/test-bank-redis.mjs test/issuance-budget-redis.integration.ts",
    "test:issuance-evm": "forge build && tsx --test test/issuance-evm.integration.ts",
    "test:cross-chain-gate": "forge build && tsx --test test/cross-chain-gate.integration.ts",
    "test:issuance-e2e": "forge build && npm --prefix web run build && node web/scripts/test-issuance-e2e.mjs",
    "test:external-credential": "forge build && tsx --test test/external-credential.test.ts",
    "test:identity-policy": "tsx --test pipeline/identity-policy.test.ts",
    "test:relay-evm": "forge build && tsx --test test/relay-evm.integration.ts",
    "test:source-reorg": "forge build && tsx --test test/source-reorg.integration.ts",
    "test:t16-recovery": "forge build && tsx --test test/t16-recovery.integration.ts",
    "test:worker-crash": "forge build && tsx --test test/worker-crash.integration.ts",
    "test:atomic-receipts": "forge build && tsx --test test/atomic-receipts.test.ts",
    "test:vault-recovery": "forge build && tsx --test test/vault-recovery.integration.ts",
    "test:t14-runtime": "forge build && tsx --test test/release-runtime.integration.ts",
    "test:t13-governance": "forge build && forge test --match-contract 'DenialCorrectionTest|GatedRwaNoteTest' && tsx --test worker/source-events.test.ts pipeline/roster-source.test.ts test/denial-correction-abi.test.ts",
    "test:epoch-publication": "forge build && tsx --test test/epoch-publication.integration.ts test/epoch-publish-cli.integration.ts",
    "test:onchain-ui": "tsx --test script/test-onchain-ui.ts",
    "test:synthetic-ui": "tsx --test script/test-synthetic-ui.ts",
    "test:training-ui": "tsx --test script/test-sanctions-training-ui.ts",
    "test:winning-ui": "node --test web/scripts/test-winning-ui.mjs",
    "test:live-demo": "node web/scripts/test-live-demo.mjs",
    "supply-chain": "tsx script/supply-chain.ts",
    "economics": "tsx script/unit-economics.ts",
    "roster:bundle": "tsx script/roster-bundle.ts",
    "epoch:sign-approval": "tsx script/sign-epoch-approval.ts",
    "epoch:renew-demo": "tsx script/renew-demo-epoch.ts",
    "roster:benchmark": "tsx script/benchmark-roster-bundle.ts",
    "check:submission": "tsx script/check-submission.ts",
    "verify:epoch": "tsx script/verify-epoch-record.ts",
    "verify:audit-export": "tsx script/verify-audit-export.ts",
    "check:freshness": "tsx script/check-demo-freshness.ts",
    "check:revocation": "tsx script/check-revocation.ts",
    "check:issuer-mode": "tsx script/check-issuer-mode.ts",
    "monitor:vault": "tsx script/monitor-vault.ts",
    "monitor:rescreen": "tsx script/monitor-rescreen.ts",
    "monitor:worker": "tsx script/monitor-worker.ts",
    "monitor:worker:service": "tsx script/monitor-worker-service.ts",
    "record:worker:service": "tsx script/record-worker-service.ts",
    "audit:worker:service": "tsx script/audit-worker-service.ts",
    "probe:worker": "tsx script/probe-worker.ts",
    "verify:submission": "bash scripts/verify-submission.sh",
    "consumer:check": "tsx examples/consumer/check.ts",
    "rescreen": "tsx script/rescreen.ts",
    "vault:admin": "tsx script/vault-admin.ts",
    "vault:recovery": "tsx script/vault-recovery.ts",
    "issuance:resume": "tsx script/resume-issuances.ts"
  },
  "dependencies": {
    "@gluwa/usc-contracts": "0.1.2",
    "@gluwa/usc-sdk": "0.18.0",
    "@openzeppelin/contracts": "5.4.0",
    "ethers": "^6.17.0",
    "saxes": "6.0.0"
  },
  "devDependencies": {
    "playwright": "^1.62.1",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  },
  "type": "module"
}
